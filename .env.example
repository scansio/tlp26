# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:pass@localhost:54322/tlp26

# Clerk authentication (required)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# AES-256-GCM key for encrypting exchange API keys (required)
EXCHANGE_KEY_ENCRYPTION_SECRET=your-32-byte-hex-secret

# Apify CryptoPanic News Scraper actor — primary crypto news + sentiment source
# (optional; falls back to direct CryptoPanic API, then CoinGecko).
# Get a token from https://apify.com and enable getascraper/cryptopanic-news-scraper.
APIFY_API_TOKEN=

# CryptoPanic direct API (optional fallback if APIFY_API_TOKEN is unset)
CRYPTOPANIC_API_TOKEN=

# Coinglass funding rates + liquidation data (optional)
COINGLASS_API_KEY=

# Shared platform Telegram bot for the one-click "Connect Telegram" flow
# (optional — without it, the Telegram notification channel stays hidden).
# 1. Create a bot via @BotFather, grab its token and username.
# 2. Set TELEGRAM_BOT_TOKEN / TELEGRAM_BOT_USERNAME below — username WITHOUT
#    the leading "@" (e.g. "my_trading_bot", not "@my_trading_bot").
# 3. Pick a TELEGRAM_WEBHOOK_SECRET (any random string, [A-Za-z0-9_-], <=256 chars).
# 4. Point the bot's webhook at this app's public HTTPS URL (one-time, from your machine):
#    curl -X POST "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" \
#      -H "Content-Type: application/json" \
#      -d '{"url": "https://<your-domain>/api/webhooks/telegram", "secret_token": "'"$TELEGRAM_WEBHOOK_SECRET"'", "allowed_updates": ["message"]}'
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# AI provider selection — change AI_PROVIDER to switch all agents at once.
# Each provider reads its model from {PROVIDER}_MODEL automatically.
AI_PROVIDER=groq   # groq | cerebras | openai | anthropic | google | mistral

# Model per provider — only the one matching AI_PROVIDER is used
GROQ_MODEL=llama-3.3-70b-versatile
CEREBRAS_MODEL=gpt-oss-120b
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GOOGLE_MODEL=gemini-flash-latest
MISTRAL_MODEL=mistral-small-latest

# Provider API keys — only the one matching AI_PROVIDER is required
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=

# Mastra Cloud trace export (optional)
MASTRA_CLOUD_ACCESS_TOKEN=

# Confluence-group trading worker (scheduled ticks, SL/TP monitor, price
# watches, signal expiry, auto-execute retries) now runs in-process via
# src/instrumentation.ts instead of a separate container. Always on in
# production; off elsewhere unless set explicitly, so `npm run dev` doesn't
# start placing trades / polling exchanges by default.
# WORKER_ENABLED=true

# Run one tick immediately on boot instead of waiting for the first scheduled
# fire (optional, default false) — useful for local integration testing.
# WORKER_RUN_ON_BOOT=true

# Worker tick cadence: primary interval driver, in minutes (optional, default 15)
WORKER_TICK_INTERVAL_MINUTES=15

# Worker session-aware cron ticks layered on top of the interval driver, semicolon-separated
# cron expressions in UTC (optional; unset defaults to funding settlement + London open + NY
# overlap; set to an empty string to disable them entirely)
# WORKER_CRON_SCHEDULES=

# Worker retry behavior for the agentDecision LLM call (optional)
WORKER_AGENT_RETRY_ATTEMPTS=3
WORKER_AGENT_RETRY_DELAY_MS=60000

# Optional: route read-only Binance market data (candles, order book) through the
# public mirror — useful where api.binance.com is geo-blocked. Trading calls unaffected.
# BINANCE_MARKET_DATA_MIRROR=https://data-api.binance.vision/api/v3

# How often the worker polls active price watches, in ms (optional, default 20000)
PRICE_WATCH_POLL_INTERVAL_MS=20000
